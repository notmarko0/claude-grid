#!/bin/bash
# sp-wip [label] — inventar nedovršenog rada u poolu.
# Odgovara na: "što sam počeo i nisam dovršio, i u kojem je to worktreeju?"
# Read-only: ništa ne mijenja. Pokreni iz repoa (ili worktreeja) ili daj label.
set -uo pipefail
. "$HOME/.local/bin/sp-common.sh"
LABEL="${1:-}"; [ -z "$LABEL" ] && { LABEL=$(sp_label_for "$PWD") || true; }
if [ -n "$LABEL" ]; then
  ROOT="${SP_ROOT:-$(sp_pool_get "$LABEL" repo)}"; INTEG=$(sp_integ "$LABEL")
else
  ROOT="${SP_ROOT:-$(sp_repo_root "$PWD" 2>/dev/null)}"; INTEG=main
fi
[ -n "$ROOT" ] || { echo "Nisi u git repou (ni pool label nije zadan)." >&2; exit 1; }
INTEG="${INTEG:-main}"
cd "$ROOT" || exit 1

# datum zadnje izmjene fajla — GNU stat (Linux/WSL) ili BSD stat (Mac)
mtime() {
  local t; t=$(stat -c '%y' "$1" 2>/dev/null) && { printf '%s' "${t:0:16}"; return; }
  stat -f '%Sm' -t '%Y-%m-%d %H:%M' "$1"
}

hr() { printf '%s\n' "────────────────────────────────────────────────────────────"; }

echo "═══ 1. STOLOVI (worktreejevi) ═══"
printf "%-9s %-30s %-7s %-9s %s\n" WT GRANA DIRTY AH/BE ZADNJI-COMMIT
git worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r p; do
  [ "$p" = "$ROOT" ] && label="MAIN-REPO" || label="$(basename "$p" | sed 's/.*-//')"
  br=$(git -C "$p" symbolic-ref --short -q HEAD 2>/dev/null || echo "(detached)")
  dirty=$(git -C "$p" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  [ "$dirty" = 0 ] && dirty="-" || dirty="DA($dirty)"
  ah=$(git -C "$p" rev-list --count "$INTEG..HEAD" 2>/dev/null || echo ?)
  be=$(git -C "$p" rev-list --count "HEAD..$INTEG" 2>/dev/null || echo ?)
  when=$(git -C "$p" log -1 --format=%cr 2>/dev/null)
  printf "%-9s %-30s %-7s %-9s %s\n" "$label" "$br" "$dirty" "+$ah/-$be" "$when"
done

hr
echo "═══ 2. GRANE KOJE NIJEDAN STOL NE DRŽI (siroti rad) ═══"
held=$(git worktree list --porcelain | awk '/^branch /{sub("refs/heads/","",$2); print $2}')
found=0
while read -r br; do
  [ "$br" = "$INTEG" ] && continue
  printf '%s\n' "$held" | grep -qx "$br" && continue
  ah=$(git rev-list --count "$INTEG..$br" 2>/dev/null || echo 0)
  merged=$(git merge-base --is-ancestor "$br" "$INTEG" 2>/dev/null && echo "u main" || echo "NIJE u main")
  when=$(git log -1 --format=%cr "$br" 2>/dev/null)
  printf "  %-34s +%-4s %-12s %s\n" "$br" "$ah" "$merged" "$when"
  found=1
done < <(git branch --format='%(refname:short)')
[ "$found" = 0 ] && echo "  (nema — svaka grana ima svoj stol)"

hr
echo "═══ 3. STASHEVI (dijeljeni kroz sve stolove) ═══"
if [ -n "$(git stash list 2>/dev/null)" ]; then git stash list | sed 's/^/  /'; else echo "  (nema)"; fi

hr
echo "═══ 4. REMOTE GRANE KOJE NISU U MAIN ═══"
git fetch origin --quiet 2>/dev/null
found=0
while read -r sha ref; do
  br=${ref#refs/heads/}
  [ "$br" = "$INTEG" ] && continue
  if ! git merge-base --is-ancestor "$sha" "origin/$INTEG" 2>/dev/null; then
    printf "  origin/%-32s %s\n" "$br" "$(git log -1 --format=%cr "$sha" 2>/dev/null)"
    found=1
  fi
done < <(git ls-remote --heads origin 2>/dev/null)
[ "$found" = 0 ] && echo "  (nema — sve remote grane su u main)"

hr
echo "═══ 5. GDJE SI IMAO CLAUDE SESIJE (zadnja aktivnost) ═══"
# Claude Code sprema transkripte u ~/.claude/projects/<putanja s / -> ->
PROJ_KEY=$(basename "$ROOT" | sed -E 's/-[0-9]+$//')
for d in "$HOME"/.claude/projects/*"$PROJ_KEY"*; do
  [ -d "$d" ] || continue
  last=$(ls -t "$d"/*.jsonl 2>/dev/null | head -1)
  [ -n "$last" ] || continue
  n=$(ls "$d"/*.jsonl 2>/dev/null | wc -l | tr -d ' ')
  printf "  %-42s %s razgovora, zadnji %s\n" \
    "$(basename "$d" | sed "s|^$(printf '%s' "$HOME" | tr '/' '-')-||")" "$n" \
    "$(mtime "$last")"
done
